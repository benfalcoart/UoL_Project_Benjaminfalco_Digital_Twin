	"item": [
		{
			"name": "get status",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response contains system state\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json).to.have.property(\"state\");\r",
							"    pm.expect(json).to.have.property(\"temperature\");\r",
							"    pm.expect(json).to.have.property(\"storageFreeGb\");\r",
							"    pm.expect(json).to.have.property(\"detectedCameraCount\");\r",
							"    pm.expect(json).to.have.property(\"activeCameraCount\");\r",
							"    pm.expect(json).to.have.property(\"timestamp\");\r",
							"});\r",
							"\r",
							"pm.test(\"Five cameras detected\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json.detectedCameraCount).to.eql(5);\r",
							"});\r",
							"\r",
							"pm.test(\"Battery data is valid if available\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    if (json.battery !== null) {\r",
							"        pm.expect(json.battery).to.have.property(\"percentage\");\r",
							"        pm.expect(json.battery).to.have.property(\"voltage\");\r",
							"        pm.expect(json.battery).to.have.property(\"current\");\r",
							"        pm.expect(json.battery).to.have.property(\"power\");\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/status",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"status"
					]
				}
			},
			"response": []
		},
