							"\r",
							"pm.test(\"Five cameras detected\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    pm.expect(json.length).to.eql(5);\r",
							"});\r",
							"\r",
							"pm.test(\"Each camera has required properties\", function () {\r",
							"    const json = pm.response.json();\r",
							"\r",
							"    json.forEach(camera => {\r",
							"        pm.expect(camera).to.have.property(\"id\");\r",
							"        pm.expect(camera).to.have.property(\"device\");\r",
							"        pm.expect(camera).to.have.property(\"name\");\r",
							"        pm.expect(camera).to.have.property(\"active\");\r",
							"        pm.expect(camera).to.have.property(\"slot\");\r",
							"    });\r",
							"});"
