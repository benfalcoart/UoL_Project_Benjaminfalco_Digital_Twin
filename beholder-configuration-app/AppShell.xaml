<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="beholder_configuration_app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:beholder_configuration_app"
    Title="beholder_configuration_app"
    Shell.BackgroundColor="#191919"
    Shell.ForegroundColor="White"
    Shell.TabBarBackgroundColor="#191919"
    Shell.TabBarForegroundColor="#3AA0FF"
    Shell.TabBarUnselectedColor="#8B949E"
    Shell.TitleColor="White">

    <!--  Icons Downloaded from: https://lucide.dev/icons/  -->
    <TabBar>
        <ShellContent
            x:Name="MainShellContent"
            Title=""
            Icon="house.png"
            Route="MainPage" />

        <ShellContent
            x:Name="ConnectionPage"
            Title=""
            Icon="wifi.png"
            Route="Connection" />

        <ShellContent
            x:Name="ProjectsContent"
            Title=""
            Icon="folder_open_dot.png"
            Route="Projects" />

        <ShellContent
            x:Name="CamerasContent"
            Title=""
            Icon="camera.png"
            Route="Cameras" />

        <ShellContent
            x:Name="SettingsContent"
            Title=""
            Icon="settings.png"
            Route="Settings" />
        <ShellContent
            x:Name="ConsoleContent"
            Title=""
            Icon="square_chevron_right.png"
            Route="Settings" />
    </TabBar>
</Shell>
