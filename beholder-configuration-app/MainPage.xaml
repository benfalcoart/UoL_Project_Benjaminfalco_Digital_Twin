<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="beholder_configuration_app.MainPage">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="20">

        <Label
            Grid.Row="0"
            Text="BEHOLDER"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="White" />

        <Label
            Grid.Row="1"
            x:Name="ConnectionLabel"
            Text="Disconnected"
            FontSize="18"
            TextColor="Orange" />

        <Button
            Grid.Row="2"
            Text="Connect"
            Clicked="OnConnectClicked" />

        <Label
            Grid.Row="3"
            Text="Latest WebSocket Message"
            FontAttributes="Bold"
            TextColor="White" />

        <ScrollView
            Grid.Row="4"
            BackgroundColor="#191919">

            <Label
                x:Name="MessageLabel"
                Padding="10"
                TextColor="White"
                LineBreakMode="WordWrap" />

        </ScrollView>

    </Grid>

</ContentPage>