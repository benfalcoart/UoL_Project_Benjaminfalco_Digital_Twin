<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="beholder_configuration_app.CamerasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cameras"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="CAMERAS"
                    TextColor="White" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center">

                    <BoxView
                        CornerRadius="5"
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="10"
                        Color="#2ECC71" />

                    <Label
                        x:Name="CameraSummaryLabel"
                        FontAttributes="Bold"
                        Text="5 / 5 ACTIVE"
                        TextColor="#2ECC71"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="PHYSICAL LAYOUT"
                TextColor="#8B949E" />

            <Border
                Padding="18"
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <!--  TOP  -->
                    <HorizontalStackLayout HorizontalOptions="Center">

                        <Button
                            x:Name="T1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="T1"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  UPPER  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

                        <Button
                            x:Name="U1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U1"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U2"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U3"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U4"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U5"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  MIDDLE  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">

                        <Button
                            x:Name="M1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M1"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M2"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M3"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M4"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M5"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M6Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M6"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M7Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M7"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M8Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M8"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M9Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M9"
                            TextColor="#8B949E"
                            WidthRequest="42" />

                    </HorizontalStackLayout>

                    <!--  LOWER  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

                        <Button
                            x:Name="L1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L1"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L2"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L3"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L4"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L5"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  BOTTOM  -->
                    <HorizontalStackLayout HorizontalOptions="Center">

                        <Button
                            x:Name="B1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="B1"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Border>

            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="CAMERA CONFIGURATION"
                TextColor="#8B949E" />

            <VerticalStackLayout x:Name="CameraConfigurationList" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>