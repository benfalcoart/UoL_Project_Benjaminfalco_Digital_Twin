<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="beholder_configuration_app.CamerasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cameras"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="CAMERAS"
                    TextColor="White" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center">

                    <BoxView
                        CornerRadius="5"
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="10"
                        Color="#2ECC71" />

                    <Label
                        x:Name="CameraSummaryLabel"
                        FontAttributes="Bold"
                        Text="5 / 5 ACTIVE"
                        TextColor="#2ECC71"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="PHYSICAL LAYOUT"
                TextColor="#8B949E" />

            <Border
                Padding="18"
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <!--  TOP  -->
                    <HorizontalStackLayout HorizontalOptions="Center">

                        <Button
                            x:Name="T1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="T1"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  UPPER  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

                        <Button
                            x:Name="U1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U1"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U2"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U3"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U4"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="U5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="U5"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  MIDDLE  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">

                        <Button
                            x:Name="M1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M1"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M2"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M3"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M4"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M5"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M6Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M6"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M7Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M7"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M8Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M8"
                            TextColor="#8B949E"
                            WidthRequest="42" />
                        <Button
                            x:Name="M9Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="M9"
                            TextColor="#8B949E"
                            WidthRequest="42" />

                    </HorizontalStackLayout>

                    <!--  LOWER  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

                        <Button
                            x:Name="L1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L1"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L2Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L2"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L3Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L3"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L4Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L4"
                            TextColor="#8B949E"
                            WidthRequest="48" />
                        <Button
                            x:Name="L5Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="L5"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>

                    <!--  BOTTOM  -->
                    <HorizontalStackLayout HorizontalOptions="Center">

                        <Button
                            x:Name="B1Button"
                            Padding="0"
                            BackgroundColor="#22252B"
                            CornerRadius="6"
                            HeightRequest="42"
                            Text="B1"
                            TextColor="#8B949E"
                            WidthRequest="48" />

                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="CAMERA SETTINGS"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="PROFILE"
                        TextColor="#8B949E" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                        <Picker
                            x:Name="CameraProfilePicker"
                            Title="Select Profile"
                            Grid.Column="0"
                            BackgroundColor="#1A1D21"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="CameraProfilePicker_SelectedIndexChanged" />

                        <Button
                            Grid.Column="1"
                            BackgroundColor="#22252B"
                            Clicked="ApplyCameraProfileButton_Clicked"
                            CornerRadius="8"
                            Text="APPLY"
                            TextColor="#3AA0FF" />

                    </Grid>

                    <Label
                        x:Name="CameraProfileDescriptionLabel"
                        FontSize="12"
                        Text=""
                        TextColor="#8B949E" />

                </VerticalStackLayout>

            </Border>
            <Border
                Padding="12"
                BackgroundColor="#22252B"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            FontAttributes="Bold"
                            Text="MANUAL CAMERA SETTINGS"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Button
                            x:Name="CameraSettingsExpandButton"
                            Grid.Column="1"
                            Padding="8,0"
                            BackgroundColor="Transparent"
                            Clicked="CameraSettingsExpandButton_Clicked"
                            Text="+"
                            TextColor="#3AA0FF" />
                    </Grid>

                    <VerticalStackLayout
                        x:Name="CameraSettingsContent"
                        IsVisible="False"
                        Spacing="12">
                        <BoxView
                            Margin="0,6"
                            HeightRequest="1"
                            Color="#333333" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="EXPOSURE"
                            TextColor="#8B949E" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Automatic Exposure"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Switch
                                x:Name="AutoExposureSwitch"
                                Grid.Column="1"
                                Toggled="AutoExposureSwitch_Toggled" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Exposure Time"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="ExposureTimeSlider"
                                Grid.Column="1"
                                Maximum="5000"
                                Minimum="1" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference ExposureTimeSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Gain"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="GainSlider"
                                Grid.Column="1"
                                Maximum="100"
                                Minimum="0" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference GainSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Dynamic Framerate"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Switch x:Name="DynamicFramerateSwitch" Grid.Column="1" />
                        </Grid>

                        <BoxView
                            Margin="0,6"
                            HeightRequest="1"
                            Color="#333333" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="WHITE BALANCE"
                            TextColor="#8B949E" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Automatic White Balance"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Switch
                                x:Name="AutoWhiteBalanceSwitch"
                                Grid.Column="1"
                                Toggled="AutoWhiteBalanceSwitch_Toggled" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,60" ColumnSpacing="10">
                            <Label
                                Text="Temperature"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="WhiteBalanceSlider"
                                Grid.Column="1"
                                Maximum="6500"
                                Minimum="2800" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference WhiteBalanceSlider}, Path=Value, StringFormat='{0:F0} K'}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView
                            Margin="0,6"
                            HeightRequest="1"
                            Color="#333333" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="IMAGE"
                            TextColor="#8B949E" />

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Brightness"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="BrightnessSlider"
                                Grid.Column="1"
                                Maximum="64"
                                Minimum="-64" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference BrightnessSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Contrast"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="ContrastSlider"
                                Grid.Column="1"
                                Maximum="64"
                                Minimum="0" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference ContrastSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Saturation"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="SaturationSlider"
                                Grid.Column="1"
                                Maximum="128"
                                Minimum="0" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference SaturationSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Hue"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="HueSlider"
                                Grid.Column="1"
                                Maximum="40"
                                Minimum="-40" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference HueSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Gamma"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="GammaSlider"
                                Grid.Column="1"
                                Maximum="500"
                                Minimum="72" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference GammaSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Sharpness"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="SharpnessSlider"
                                Grid.Column="1"
                                Maximum="6"
                                Minimum="0" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference SharpnessSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,50" ColumnSpacing="10">
                            <Label
                                Text="Backlight"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />
                            <Slider
                                x:Name="BacklightSlider"
                                Grid.Column="1"
                                Maximum="160"
                                Minimum="0" />
                            <Label
                                Grid.Column="2"
                                HorizontalTextAlignment="End"
                                Text="{Binding Source={x:Reference BacklightSlider}, Path=Value, StringFormat='{0:F0}'}"
                                TextColor="White" />
                        </Grid>

                        <BoxView
                            Margin="0,6"
                            HeightRequest="1"
                            Color="#333333" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="LIGHTING"
                            TextColor="#8B949E" />

                        <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                            <Label
                                Text="Power Frequency"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />

                            <Picker
                                x:Name="PowerFrequencyPicker"
                                Grid.Column="1"
                                BackgroundColor="#1A1D21">
                                <Picker.Items>
                                    <x:String>Disabled</x:String>
                                    <x:String>50 Hz</x:String>
                                    <x:String>60 Hz</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <Button
                            Margin="0,8,0,0"
                            BackgroundColor="#22252B"
                            Clicked="ApplyCameraSettingsButton_Clicked"
                            CornerRadius="8"
                            Text="APPLY SETTINGS TO ALL CAMERAS"
                            TextColor="#3AA0FF" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="CAMERA CONFIGURATION"
                TextColor="#8B949E" />

            <VerticalStackLayout x:Name="CameraConfigurationList" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>