<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="beholder_configuration_app.CamerasPage"
    Title="Cameras"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">
            <Grid
                ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="CAMERAS"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center">

                    <BoxView
                        WidthRequest="10"
                        HeightRequest="10"
                        CornerRadius="5"
                        Color="#2ECC71"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="CameraSummaryLabel"
                        Text="5 / 5 ACTIVE"
                        FontAttributes="Bold"
                        TextColor="#2ECC71"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Grid>

            <Label
                Text="PHYSICAL LAYOUT"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#8B949E" />

            <Border
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="10">

                    <!-- TOP -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center">

                        <Button
                            Text="T1"
                            WidthRequest="48"
                            HeightRequest="42"
                            Padding="0"
                            BackgroundColor="#22252B"
                            TextColor="#8B949E"
                            CornerRadius="6" />

                    </HorizontalStackLayout>

                    <!-- UPPER -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6">

                        <Button Text="U1" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="U2" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="U3" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="U4" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="U5" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />

                    </HorizontalStackLayout>

                    <!-- MIDDLE -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4">

                        <Button Text="M1" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M2" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M3" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M4" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M5" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M6" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M7" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M8" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="M9" WidthRequest="42" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />

                    </HorizontalStackLayout>

                    <!-- LOWER -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6">

                        <Button Text="L1" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="L2" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="L3" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="L4" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />
                        <Button Text="L5" WidthRequest="48" HeightRequest="42" Padding="0" BackgroundColor="#22252B" TextColor="#8B949E" CornerRadius="6" />

                    </HorizontalStackLayout>

                    <!-- BOTTOM -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center">

                        <Button
                            Text="B1"
                            WidthRequest="48"
                            HeightRequest="42"
                            Padding="0"
                            BackgroundColor="#22252B"
                            TextColor="#8B949E"
                            CornerRadius="6" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="CAMERA CONFIGURATION"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#8B949E" />

            <VerticalStackLayout
                x:Name="CameraConfigurationList"
                Spacing="12">

                <!-- Temporary sample card. TODO: Replace this with actual detected cameras.-->
                <Border
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="12">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Camera 1"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                <BoxView
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    CornerRadius="4"
                                    Color="#2ECC71"
                                    VerticalOptions="Center" />

                                <Label
                                    Text="ACTIVE"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#2ECC71"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </Grid>

                        <Label
                            Text="/dev/video0"
                            FontSize="12"
                            TextColor="#8B949E" />

                        <Grid
                            ColumnDefinitions="90,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Row"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />

                            <Picker
                                Grid.Row="0"
                                Grid.Column="1"
                                Title="Select Row">
                                <Picker.Items>
                                    <x:String>Unassigned</x:String>
                                    <x:String>Top</x:String>
                                    <x:String>Upper</x:String>
                                    <x:String>Middle</x:String>
                                    <x:String>Lower</x:String>
                                    <x:String>Bottom</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Slot"
                                TextColor="#C9D1D9"
                                VerticalOptions="Center" />

                            <Picker
                                Grid.Row="1"
                                Grid.Column="1"
                                Title="Select Slot" />

                        </Grid>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button
                                Grid.Column="0"
                                Text="IDENTIFY"
                                BackgroundColor="#22252B"
                                TextColor="#3AA0FF"
                                CornerRadius="8" />

                            <Button
                                Grid.Column="1"
                                Text="DISABLE"
                                BackgroundColor="#22252B"
                                TextColor="#E74C3C"
                                CornerRadius="8" />

                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>