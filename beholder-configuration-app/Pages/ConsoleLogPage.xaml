<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="beholder_configuration_app.Pages.ConsoleLogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ConsoleLogPage"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">
        <Label
            Grid.Row="0"
            FontAttributes="Bold"
            FontSize="28"
            Text="DIAGNOSTIC LOG"
            TextColor="White" />

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">

            <Label
                Text="Application and communication events"
                TextColor="#8B949E"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                BackgroundColor="#22252B"
                Clicked="OnCopyClicked"
                Text="COPY"
                TextColor="#3AA0FF" />

            <Button
                Grid.Column="2"
                BackgroundColor="#22252B"
                Clicked="OnClearClicked"
                Text="CLEAR"
                TextColor="#E74C3C" />

        </Grid>


        <CollectionView
            x:Name="LogCollection"
            Grid.Row="2"
            VerticalScrollBarVisibility="Always">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        BackgroundColor="#191919"
                        Stroke="#444444">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                            <Label
                                FontFamily="Courier New"
                                FontSize="12"
                                Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}"
                                TextColor="#8B949E" />

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding Level}"
                                TextColor="#3AA0FF" />

                            <Label
                                Grid.Column="2"
                                FontFamily="Courier New"
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="{Binding Message}"
                                TextColor="White" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>