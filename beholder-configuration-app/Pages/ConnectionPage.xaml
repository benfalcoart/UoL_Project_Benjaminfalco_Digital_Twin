<ContentPage
    x:Class="beholder_configuration_app.ConnectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Connection"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="24" Spacing="18">

        <Label
            FontAttributes="Bold"
            FontSize="24"
            Text="CONNECT TO BEHOLDER"
            TextColor="White" />

        <Label Text="Address" TextColor="#8B949E" />

        <Picker
            x:Name="ConnectionPresetPicker"
            Title="Select Connection"
            BackgroundColor="#1A1D21"
            SelectedIndexChanged="OnConnectionPresetChanged" />
        <Entry
            x:Name="AddressEntry"
            BackgroundColor="#1A1D21"
            Placeholder="BEHOLDER address"
            Text="192.168.0.130" />

        <Label Text="Port" TextColor="#8B949E" />

        <Entry
            x:Name="PortEntry"
            BackgroundColor="#1A1D21"
            Keyboard="Numeric"
            Text="8000" />

        <Label Text="Password" TextColor="#8B949E" />

        <Entry
            x:Name="PasswordEntry"
            BackgroundColor="#1A1D21"
            IsPassword="True"
            Placeholder="Password" />

        <Button
            BackgroundColor="#3AA0FF"
            Clicked="OnConnectClicked"
            CornerRadius="8"
            FontAttributes="Bold"
            HeightRequest="56"
            Text="CONNECT"
            TextColor="White" />

        <Label
            x:Name="StatusLabel"
            Text="Disconnected"
            TextColor="#8B949E" />

    </VerticalStackLayout>

</ContentPage>