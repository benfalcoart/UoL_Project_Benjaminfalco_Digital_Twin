<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="beholder_configuration_app.ProjectsPage"
    Title="Projects"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="PROJECTS"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="CURRENT PROJECT"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#8B949E" />

            <Border
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="6">

                        <HorizontalStackLayout
                            Spacing="8">

                            <BoxView
                                WidthRequest="10"
                                HeightRequest="10"
                                CornerRadius="5"
                                Color="#2ECC71"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="CurrentProjectNameLabel"
                                Text="No project selected"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </HorizontalStackLayout>

                        <Label
                            x:Name="CurrentProjectCaptureLabel"
                            Text="No active capture"
                            TextColor="#C9D1D9" />

                        <Label
                            x:Name="CurrentProjectStatsLabel"
                            Text="— images · — GB"
                            FontSize="13"
                            TextColor="#8B949E" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="CLOSE"
                        BackgroundColor="#22252B"
                        TextColor="#C9D1D9"
                        CornerRadius="8"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <Button
                Text="+ NEW PROJECT"
                HeightRequest="52"
                BackgroundColor="#3AA0FF"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                Clicked="OnNewProjectClicked" />

            <Grid
                ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="ON BEHOLDER"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="#8B949E"
                    VerticalOptions="Center" />

                <Label
                    x:Name="ProjectCountLabel"
                    Grid.Column="1"
                    Text="0 PROJECTS"
                    FontSize="12"
                    TextColor="#8B949E"
                    VerticalOptions="Center" />

            </Grid>

            <VerticalStackLayout
                x:Name="ProjectList"
                Spacing="10">

                <!-- Temporary design placeholder -->
                <Border
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4">

                            <Label
                                Text="Example Project"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="640 images · 1.3 GB"
                                TextColor="#C9D1D9" />

                            <Label
                                Text="Last capture #128"
                                FontSize="12"
                                TextColor="#8B949E" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="OPEN"
                            BackgroundColor="#22252B"
                            TextColor="#3AA0FF"
                            CornerRadius="8"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>