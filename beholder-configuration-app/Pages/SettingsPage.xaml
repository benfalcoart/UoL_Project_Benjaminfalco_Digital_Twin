<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="beholder_configuration_app.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                Text="SETTINGS"
                TextColor="White" />

            <!--  CONNECTION  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="CONNECTION"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                Text="BEHOLDER"
                                TextColor="White" />

                            <Label
                                x:Name="ConnectionAddressLabel"
                                Text="192.168.0.130:8000"
                                TextColor="#8B949E" />

                        </VerticalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">

                            <BoxView
                                x:Name="SettingsConnectionIndicator"
                                CornerRadius="4"
                                HeightRequest="8"
                                VerticalOptions="Center"
                                WidthRequest="8"
                                Color="#2ECC71" />

                            <Label
                                x:Name="SettingsConnectionStatusLabel"
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="CONNECTED"
                                TextColor="#2ECC71" />

                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  FIELD BEHAVIOUR  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="FIELD BEHAVIOUR"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Keep Screen Awake"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Switch
                            x:Name="KeepScreenAwakeSwitch"
                            Grid.Column="1"
                            Toggled="OnKeepScreenAwakeToggled" />

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Haptic Feedback"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Switch
                            x:Name="HapticFeedbackSwitch"
                            Grid.Column="1"
                            Toggled="OnHapticFeedbackToggled" />

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Capture Sound"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Switch
                            x:Name="CaptureSoundSwitch"
                            Grid.Column="1"
                            Toggled="OnCaptureSoundToggled" />

                    </Grid>

                    <Grid ColumnDefinitions="*,100">

                        <Label
                            Text="Default Automatic Interval"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Entry
                            x:Name="DefaultIntervalEntry"
                            Grid.Column="1"
                            HorizontalTextAlignment="Center"
                            Keyboard="Numeric"
                            Text="0.50"
                            Unfocused="OnDefaultIntervalUnfocused" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  DATA TRANSFER  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="DATA TRANSFER"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="12"
                        Text="Current Project"
                        TextColor="#8B949E" />

                    <Label
                        x:Name="TransferProjectNameLabel"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="No project selected"
                        TextColor="White" />

                    <Label
                        x:Name="TransferProjectStatsLabel"
                        Text="— images · — GB"
                        TextColor="#C9D1D9" />

                    <Button
                        BackgroundColor="#3AA0FF"
                        Clicked="OnOffloadCurrentProjectClicked"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Text="OFFLOAD CURRENT PROJECT"
                        TextColor="White" />

                    <Button
                        BackgroundColor="#22252B"
                        Clicked="OnOffloadAllProjectsClicked"
                        CornerRadius="8"
                        Text="OFFLOAD ALL PROJECTS"
                        TextColor="#3AA0FF" />
                    <VerticalStackLayout
                        x:Name="TransferProgressPanel"
                        IsVisible="False"
                        Spacing="8">

                        <ProgressBar x:Name="TransferProgressBar" Progress="0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                x:Name="TransferStatusLabel"
                                Text="Preparing transfer..."
                                TextColor="#C9D1D9" />

                            <Label
                                x:Name="TransferPercentLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                Text="0%"
                                TextColor="White" />

                        </Grid>
                        <Label
                            x:Name="TransferFileLabel"
                            FontSize="11"
                            LineBreakMode="MiddleTruncation"
                            TextColor="#8B949E" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <!--  DIAGNOSTICS  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="DIAGNOSTICS"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="WebSocket" TextColor="#C9D1D9" />

                        <Label
                            x:Name="WebSocketStatusLabel"
                            Grid.Column="1"
                            Text="Disconnected"
                            TextColor="#E74C3C" />

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Last Status Update" TextColor="#C9D1D9" />

                        <Label
                            Grid.Column="1"
                            Text="0.3 sec ago"
                            TextColor="White" />

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="API Version" TextColor="#C9D1D9" />

                        <Label
                            Grid.Column="1"
                            Text="0.1.0"
                            TextColor="White" />

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="App Version" TextColor="#C9D1D9" />

                        <Label
                            Grid.Column="1"
                            Text="0.1.0"
                            TextColor="White" />

                    </Grid>
                    <Button
                        BackgroundColor="#22252B"
                        Clicked="OnForceStatusRefreshClicked"
                        CornerRadius="8"
                        Text="FORCE STATUS REFRESH"
                        TextColor="#C9D1D9" />

                </VerticalStackLayout>

            </Border>

            <!--  SECURITY  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="SECURITY"
                TextColor="#8B949E" />

            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout>

                        <Label
                            FontAttributes="Bold"
                            Text="Authentication"
                            TextColor="White" />

                        <Label Text="Not configured" TextColor="#8B949E" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        BackgroundColor="#22252B"
                        CornerRadius="8"
                        Text="SECURITY"
                        TextColor="#C9D1D9" />

                </Grid>

            </Border>

            <!--  ADVANCED  -->
            <Label
                FontAttributes="Bold"
                FontSize="12"
                Text="ADVANCED"
                TextColor="#8B949E" />

            <Button
                BackgroundColor="#191919"
                BorderColor="#444444"
                BorderWidth="1"
                Clicked="OnResetPreferencesClicked"
                CornerRadius="8"
                Text="RESET APP PREFERENCES"
                TextColor="#E74C3C" />

            <BoxView HeightRequest="30" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>