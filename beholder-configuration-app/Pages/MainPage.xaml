<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="beholder_configuration_app.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#101214"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="20">

            <!--  Header  -->
            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="2">

                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="BEHOLDER"
                        TextColor="White" />

                    <Label
                        FontSize="13"
                        Text="Capture Control"
                        TextColor="#8B949E" />

                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center">
                    <!-- Removed to place in tab bar for better navigation
                    <Button
                        x:Name="ConnectionButton"
                        Grid.Column="1"
                        Text="CONNECT"
                        BackgroundColor="#22252B"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnConnectionClicked" />
                    -->
                    <BoxView
                        x:Name="ConnectionIndicator"
                        CornerRadius="5"
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="10"
                        Color="#E74C3C" />
                    <Label
                        x:Name="ConnectionLabel"
                        FontAttributes="Bold"
                        Text="OFFLINE"
                        TextColor="#E74C3C"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Grid>


            <!--  Current project  -->
            <Border
                Padding="18"
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="5">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="CURRENT PROJECT"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="ProjectNameLabel"
                            FontAttributes="Bold"
                            FontSize="22"
                            Text="No project selected"
                            TextColor="White" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="End"
                        Spacing="5">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalTextAlignment="End"
                            Text="CAPTURE"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="CaptureIdLabel"
                            FontAttributes="Bold"
                            FontSize="22"
                            HorizontalTextAlignment="End"
                            Text="#—"
                            TextColor="White" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!--  Capture mode  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <Button
                    x:Name="SingleModeButton"
                    Grid.Column="0"
                    BackgroundColor="#3AA0FF"
                    Clicked="OnSingleModeClicked"
                    CornerRadius="8"
                    Text="SINGLE"
                    TextColor="White" />

                <Button
                    x:Name="AutomaticModeButton"
                    Grid.Column="1"
                    BackgroundColor="#22252B"
                    Clicked="OnAutomaticModeClicked"
                    CornerRadius="8"
                    Text="AUTOMATIC"
                    TextColor="#C9D1D9" />

            </Grid>


            <!--  Main capture button  -->
            <Button
                x:Name="CaptureButton"
                BackgroundColor="#3AA0FF"
                CornerRadius="8"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="60"
                Text="CAPTURE"
                TextColor="White" />


            <!--  Automatic interval  -->
            <Border
                x:Name="AutomaticOptionsPanel"
                Padding="14"
                BackgroundColor="#191919"
                IsVisible="False"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="AUTOMATIC CAPTURE"
                            TextColor="#8B949E"
                            VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="8">

                            <BoxView
                                x:Name="AutomaticRunningIndicator"
                                CornerRadius="5"
                                HeightRequest="10"
                                VerticalOptions="Center"
                                WidthRequest="10"
                                Color="#8B949E" />

                            <Label
                                x:Name="AutomaticRunningLabel"
                                FontAttributes="Bold"
                                Text="STOPPED"
                                TextColor="#8B949E"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0" Spacing="2">

                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="CAPTURE INTERVAL"
                                TextColor="#8B949E" />

                            <Label
                                FontSize="11"
                                Text="Seconds between captures"
                                TextColor="#8B949E" />

                        </VerticalStackLayout>

                        <Entry
                            x:Name="AutomaticIntervalEntry"
                            Grid.Column="1"
                            HorizontalTextAlignment="Center"
                            Keyboard="Numeric"
                            Text="0.50"
                            TextChanged="OnAutomaticIntervalTextChanged"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="2"
                            BackgroundColor="#22252B"
                            Clicked="OnAutomaticIntervalApplyClicked"
                            CornerRadius="8"
                            Text="APPLY"
                            TextColor="#3AA0FF" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!--  System health heading  -->
            <Label
                Margin="0,8,0,0"
                FontAttributes="Bold"
                FontSize="13"
                Text="SYSTEM HEALTH"
                TextColor="#8B949E" />


            <!--  Health cards  -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="12">

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="16"
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="CAMERAS"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="CameraCountLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="— / —"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Border>


                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="16"
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="BATTERY"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="BatteryLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="—%"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Border>


                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="16"
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="TEMPERATURE"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="TemperatureLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="— °C"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Border>


                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="16"
                    BackgroundColor="#191919"
                    Stroke="#444444"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="STORAGE"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="StorageLabel"
                            FontAttributes="Bold"
                            FontSize="24"
                            Text="— GB"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Border>
            </Grid>


            <!--  Capture status  -->
            <Border
                Padding="16"
                BackgroundColor="#191919"
                Stroke="#444444"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="3">

                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="CAPTURE STATUS"
                            TextColor="#8B949E" />

                        <Label
                            x:Name="CaptureStatusLabel"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Idle"
                            TextColor="White" />

                    </VerticalStackLayout>

                    <BoxView
                        x:Name="CaptureStatusIndicator"
                        Grid.Column="1"
                        CornerRadius="6"
                        HeightRequest="12"
                        VerticalOptions="Center"
                        WidthRequest="12"
                        Color="#2ECC71" />

                </Grid>

            </Border>


            <!--  Cameras  -->
            <Label
                Margin="0,8,0,0"
                FontAttributes="Bold"
                FontSize="13"
                Text="CAMERAS"
                TextColor="#8B949E" />

            <VerticalStackLayout x:Name="CameraList" Spacing="8" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>